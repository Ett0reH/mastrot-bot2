# =============================================================================
# MastroT / ARBITER — variabili d'ambiente (vedi src/engine/config/config.ts)
# Il server NON parte se la configurazione non è valida: controlla i log all'avvio.
# =============================================================================

# --- Modalità -----------------------------------------------------------------
# shadow = dati di mercato reali, fill simulati, NESSUN ordine (default sicuro)
# demo   = ordini su Kraken demo (https://demo-futures.kraken.com)
# live   = ordini REALI: richiede LIVE_TRADING_CONFIRM, tutti i limiti, alert e ADMIN_TOKEN
TRADING_MODE=shadow

# Chiavi Kraken Futures separate per ambiente (mai chiavi live in sviluppo o nei test).
# Crea le chiavi SENZA permesso di prelievo.
KRAKEN_DEMO_API_KEY=
KRAKEN_DEMO_API_SECRET=
KRAKEN_LIVE_API_KEY=
KRAKEN_LIVE_API_SECRET=

# Solo per TRADING_MODE=live: deve valere esattamente I_ACCEPT_REAL_MONEY_RISK
LIVE_TRADING_CONFIRM=

# --- Limiti del live test (guardrail; in live vanno impostati TUTTI) ------------
CAPITAL_CAP_USD=1000
MAX_LEVERAGE=3
MAX_POSITION_NOTIONAL_USD=1000
MAX_OPEN_POSITIONS=8
MAX_DAILY_LOSS_PCT=5
DRAWDOWN_REDUCE_ONLY_PCT=15

# Simboli (default: BTC,ETH,SOL,AVAX,XRP,DOGE,LINK,ADA)
# SYMBOLS=BTC,ETH,SOL,AVAX,XRP,DOGE,LINK,ADA

# Modello di stop: close_based_plus_native_backstop (default) | native_intrabar
# STOP_MODEL=close_based_plus_native_backstop
# BACKSTOP_BUFFER_PCT=3

# --- Alert (obbligatori in live) ----------------------------------------------
# none | telegram | webhook
ALERT_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Accesso alle API -----------------------------------------------------------
# Token lunghi (≥ 24 caratteri casuali), es.: openssl rand -hex 32
# ADMIN_TOKEN protegge dashboard e API di controllo; senza, le API di controllo sono disabilitate.
ADMIN_TOKEN=
# CRON_TOKEN protegge /api/cron/tick (header "Authorization: Bearer <token>" oppure ?token=<token>).
CRON_TOKEN=

# --- Firestore (solo lato server, Firebase Admin SDK) --------------------------
# JSON completo di un service account con accesso a Firestore. Se vuoto si usano le
# Application Default Credentials (es. il service account di Cloud Run).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Scritture giornaliere massime su Firestore (default 3000; misurate in shadow ~1.600/giorno).
# Oltre la soglia si sospendono journal ed equity (mai stato, ordini e lease) con un alert.
# FIRESTORE_DAILY_WRITE_BUDGET=3000
# In demo e live Firestore è obbligatorio: senza, il server non parte.

# --- Solo per i vecchi backtest su dati Alpaca (src/server/backtest/run.ts) -----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# APP_URL: iniettata da AI Studio con l'URL del servizio Cloud Run.
APP_URL="MY_APP_URL"

# --- Variabili LEGACY (deprecate, non decidono più nulla) -----------------------
# LIVE_TRADING_ENABLED, KRAKEN_SANDBOX, KRAKEN_API_KEY, KRAKEN_SECRET_KEY:
# producono solo un avviso. In demo le chiavi legacy sono accettate solo con KRAKEN_SANDBOX=true.
