rules_version = '2';

// Firestore è accessibile SOLO dal server tramite Firebase Admin SDK (service account),
// che non è soggetto a queste regole. Ogni accesso dai client (browser, SDK web) è negato.
// In passato l'autorizzazione alla scrittura era un segreto salvato nello stesso documento
// leggibile pubblicamente: chiunque leggeva il documento poteva anche riscriverlo (F1, D05).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
